# ─── VANTA configuration ───────────────────────────────────────────
# true  = use the built-in demo Route Handlers (/api/*) and sample data.
# false = use NEXT_PUBLIC_API_BASE_URL (your real backend).
NEXT_PUBLIC_USE_DEMO_API=true

# EXAMPLE ONLY — replace with the real backend URL. Never ship localhost.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Public site URL (no trailing slash) used for canonical links, hreflang, Open Graph,
# JSON-LD, robots.txt and sitemap.xml. Optional: when empty, Vercel's production domain
# (VERCEL_PROJECT_PRODUCTION_URL) is used, then https://e-commerce-new2-delta.vercel.app.
# Never set it to localhost in a deployed environment.
NEXT_PUBLIC_SITE_URL=
