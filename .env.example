# ─── VANTA configuration ───────────────────────────────────────────
# true  = use the built-in demo Route Handlers (/api/*) and sample data.
# false = use NEXT_PUBLIC_API_BASE_URL (your real backend).
NEXT_PUBLIC_USE_DEMO_API=true

# EXAMPLE ONLY — replace with the real backend URL. Never ship localhost.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Public site URL used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
